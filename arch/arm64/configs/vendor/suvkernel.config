# SuvKernel, merged after redwood-fragment.config
CONFIG_LOCALVERSION="-SuvKernel-2.0"
# CONFIG_LOCALVERSION_AUTO is not set

# KernelSU-Next, manual hooks only (no kprobes)
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_DEBUG is not set

# SuSFS
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y

# Userspace device-mapper target, for applying a compressed OTA while booted
CONFIG_DM_USER=y

# EROFS, for the apex payloads that use it
CONFIG_EROFS_FS=y
# CONFIG_EROFS_FS_DEBUG is not set
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_CLUSTER_PAGE_LIMIT=1

# tmpfs xattrs, for setfilecon() on tmpfs and tmpfs as an overlayfs upperdir
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# overlayfs rename tracking, hardlink index and metadata-only copy up
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_METACOPY=y

# Networking that Android 17 needs and the AtomX defconfig leaves out.
# netd's iptables rules use NFLOG, and netd exits without it.
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_SOCK_MSG=y
CONFIG_XFRM_MIGRATE=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_XCBC=y

# Required by Android's base kernel configuration
CONFIG_UTS_NS=y
